# Copy this file to .env and adjust the values.
# Never commit the real .env file.
# The values below work out of the box for local development only.

# Application
NODE_ENV=development
PORT=3000

# Docker Compose: host port of the web app (http://localhost:8080 by default)
WEB_PORT=8080

# Database
# 127.0.0.1 instead of localhost: the port is published on IPv4 only,
# and on Windows "localhost" may resolve to the IPv6 address ::1 first.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=user_management
DB_USER=user_management
DB_PASSWORD=change-me-local-dev-password

# JWT
# At least 32 characters. Generate a strong secret for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_EXPIRES_IN=1h

# Sign-in rate limit: attempts per client IP address and time window
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW=1m

# Number of reverse proxies in front of the API whose X-Forwarded-For header
# is trusted. 0 when the API is reached directly; Docker Compose sets 1 (nginx).
TRUST_PROXY_HOPS=0

# Demo data
# Seeds 2 admins and 3 standard users, but only into an empty users table.
# Keep it false in production. All demo users share SEED_DEMO_PASSWORD
# (at least 8 characters); the usernames are listed in the README.
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=Demo.Pass.2026
