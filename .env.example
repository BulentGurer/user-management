# Copy this file to .env and adjust the values.
# Never commit the real .env file.

# Database
# 127.0.0.1 instead of localhost: the port is published on IPv4 only,
# and on Windows "localhost" may resolve to the IPv6 address ::1 first.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=user_management
DB_USER=user_management
DB_PASSWORD=change-me-local-dev-password
